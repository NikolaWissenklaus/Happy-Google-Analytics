-- v1: 03/11/2019

config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.udf,
  name: "is_valid_cpf",
  description: "Validates a CPF with the check digits (formatted or not). Used to cut false positives in the PII scanner",
  dependencies: ["ops_bootstrap_datasets"],
  tags: ["udf", "daily", "lgpd"]
}

-- regex alone catches any 11 digits (order ids, phones...). with the check digits
-- only ~1% of random numbers pass, so the PII report stays useful.
CREATE OR REPLACE FUNCTION ${self()}(value STRING) RETURNS BOOL LANGUAGE js AS r"""
  if (value === null || value === undefined) return null;
  var d = String(value).replace(/\D/g, '');
  if (d.length !== 11) return false;
  if (/^(\d)\1{10}$/.test(d)) return false;   // 111.111.111-11 passes the math but is not real
  var sum = 0, i, r;
  for (i = 0; i < 9; i++) sum += Number(d.charAt(i)) * (10 - i);
  r = (sum * 10) % 11;
  if (r === 10) r = 0;
  if (r !== Number(d.charAt(9))) return false;
  sum = 0;
  for (i = 0; i < 10; i++) sum += Number(d.charAt(i)) * (11 - i);
  r = (sum * 10) % 11;
  if (r === 10) r = 0;
  return r === Number(d.charAt(10));
"""
OPTIONS (description = "CPF check digits validation")
