-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 29/04/2019

config {
  type: "table",
  schema: constants.SCHEMAS.attribution,
  name: "attr_data_driven_summary",
  description: "One line per channel with the 3 opinions that matter (last 90 days, primary key event): last non-direct click (what GA4 reports by default), linear (the democratic one) and the data driven ones (Markov + Shapley). The 'consensus' is the average of the data driven models",
  bigquery: {
    labels: { layer: "marts", domain: "attribution" }
  },
  tags: ["marts", "attribution", "daily"],
  columns: {
    consensus_conversions: "Average of Markov and Shapley (when both exist)",
    budget_signal: "increase / keep / review, comparing the consensus with last click"
  }
}

WITH
primary_key_event AS (
  SELECT key_event_name FROM ${ref("seed_key_events")} WHERE is_primary LIMIT 1
),

rule_based AS (
  SELECT
    channel,
    SUM(credit_last_non_direct) AS last_non_direct_conversions,
    SUM(credit_linear) AS linear_conversions,
    SUM(credit_last_non_direct * conversion_value) AS last_non_direct_value,
    SUM(credit_linear * conversion_value) AS linear_value
  FROM ${ref("attr_credits_rule_based")}
  WHERE conversion_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 90 DAY)
    AND key_event_name IN (SELECT key_event_name FROM primary_key_event)
  GROUP BY channel
),

markov AS (
  SELECT channel, attributed_conversions AS markov_conversions, attributed_value AS markov_value, removal_effect
  FROM ${ref("attr_markov_removal_effects")}
  WHERE key_event_name IN (SELECT key_event_name FROM primary_key_event)
),

shapley AS (
  SELECT channel, attributed_conversions AS shapley_conversions, attributed_value AS shapley_value
  FROM ${ref("attr_shapley_values")}
  WHERE key_event_name IN (SELECT key_event_name FROM primary_key_event)
)

SELECT
  channel,
  r.last_non_direct_conversions,
  r.linear_conversions,
  m.markov_conversions,
  s.shapley_conversions,
  (COALESCE(m.markov_conversions, s.shapley_conversions) + COALESCE(s.shapley_conversions, m.markov_conversions)) / 2 AS consensus_conversions,
  r.last_non_direct_value,
  r.linear_value,
  m.markov_value,
  s.shapley_value,
  (COALESCE(m.markov_value, s.shapley_value) + COALESCE(s.shapley_value, m.markov_value)) / 2 AS consensus_value,
  m.removal_effect,
  CASE
    WHEN r.last_non_direct_conversions IS NULL OR r.last_non_direct_conversions = 0 THEN 'only_assists'
    WHEN (COALESCE(m.markov_conversions, s.shapley_conversions) + COALESCE(s.shapley_conversions, m.markov_conversions)) / 2 > 1.2 * r.last_non_direct_conversions THEN 'increase (undervalued by last click)'
    WHEN (COALESCE(m.markov_conversions, s.shapley_conversions) + COALESCE(s.shapley_conversions, m.markov_conversions)) / 2 < 0.8 * r.last_non_direct_conversions THEN 'review (overvalued by last click)'
    ELSE 'keep'
  END AS budget_signal,
  CURRENT_TIMESTAMP() AS loaded_at
FROM rule_based AS r
FULL OUTER JOIN markov AS m USING (channel)
FULL OUTER JOIN shapley AS s USING (channel)
