-- author: Francisco Lucas / Nikola Wissenklaus / Chico

config {
  type: "table",
  schema: constants.SCHEMAS.cro,
  name: "cro_checkout_friction",
  description: "Checkout friction (last 90 days) by device and payment type: median minutes between checkout steps, steps repeated (people coming back to fix address / payment), payment retries (card declined?) and the conversion of sessions with and without friction",
  bigquery: {
    labels: { layer: "marts", domain: "cro" }
  },
  tags: ["marts", "cro", "daily", "ecommerce"]
}

WITH
checkout_sessions AS (
  SELECT
    f.session_key,
    s.device_category,
    COALESCE(f.last_payment_type, '(not set)') AS payment_type,
    f.first_begin_checkout_ts,
    f.first_add_shipping_info_ts,
    f.first_add_payment_info_ts,
    f.first_purchase_ts,
    f.begin_checkout_events,
    f.add_shipping_info_events,
    f.add_payment_info_events,
    f.has_payment_retries,
    s.has_purchase
  FROM ${ref("int_ga4__session_ecommerce_flags")} AS f
  JOIN ${ref("fct_sessions")} AS s USING (session_key)
  WHERE f.session_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 90 DAY)
    AND s.session_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 91 DAY)
    AND f.has_begin_checkout
    ${helpers.martSessionFilter("s")}
)

SELECT
  device_category,
  payment_type,
  COUNT(*) AS checkout_sessions,
  APPROX_QUANTILES(TIMESTAMP_DIFF(first_add_shipping_info_ts, first_begin_checkout_ts, SECOND) / 60, 2)[OFFSET(1)] AS median_min_checkout_to_shipping,
  APPROX_QUANTILES(TIMESTAMP_DIFF(first_add_payment_info_ts, first_add_shipping_info_ts, SECOND) / 60, 2)[OFFSET(1)] AS median_min_shipping_to_payment,
  APPROX_QUANTILES(TIMESTAMP_DIFF(first_purchase_ts, first_add_payment_info_ts, SECOND) / 60, 2)[OFFSET(1)] AS median_min_payment_to_purchase,
  SAFE_DIVIDE(COUNTIF(add_shipping_info_events > 1), COUNT(*)) AS shipping_step_repeated_rate,
  SAFE_DIVIDE(COUNTIF(has_payment_retries), COUNTIF(add_payment_info_events > 0)) AS payment_retry_rate,
  SAFE_DIVIDE(COUNTIF(has_purchase AND (add_shipping_info_events > 1 OR has_payment_retries)), COUNTIF(add_shipping_info_events > 1 OR has_payment_retries)) AS conversion_with_friction,
  SAFE_DIVIDE(COUNTIF(has_purchase AND NOT (add_shipping_info_events > 1 OR has_payment_retries)), COUNTIF(NOT (add_shipping_info_events > 1 OR has_payment_retries))) AS conversion_without_friction,
  CURRENT_TIMESTAMP() AS loaded_at
FROM checkout_sessions
GROUP BY 1, 2
