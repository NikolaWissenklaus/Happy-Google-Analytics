-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 17/11/2026

config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.udf,
  name: "louvain_communities",
  description: "Communities of a weighted undirected graph with the Louvain method (Blondel et al. 2008): every node gets a community (named after its strongest member), the size of the community, the strength of the node and the modularity of the partition",
  dependencies: ["ops_bootstrap_datasets"],
  tags: ["udf", "daily", "models", "insights"]
}

-- The catalog has departments that the merchandising team drew. The customers draw others with
-- their navigation: products viewed in the same session pull each other together. Louvain finds
-- the groups with way more weight inside than a random graph with the same degrees would have
-- (modularity Q), moving one node at a time to the community where Q grows the most, then
-- collapsing every community into one node and starting again. Q above ~0.3 = real structure.
-- Deterministic: fixed pseudo random order, ties keep the current community. Edges are undirected
-- (a -> b and b -> a are added together), self loops and weights <= 0 are ignored. Up to a few
-- thousand nodes and ~100k edges per call
CREATE OR REPLACE FUNCTION ${self()}(edges ARRAY<STRUCT<src STRING, dst STRING, weight FLOAT64>>, max_levels FLOAT64)
RETURNS ARRAY<STRUCT<node STRING, community STRING, community_size FLOAT64, strength FLOAT64, modularity FLOAT64>>
LANGUAGE js AS r"""
  var levels = (max_levels === null || max_levels === undefined) ? 10 : Math.max(1, Math.round(max_levels));
  var index = {}, names = [];
  function idOf(name) {
    if (index[name] === undefined) { index[name] = names.length; names.push(name); }
    return index[name];
  }
  var raw = [];
  var list = edges || [];
  for (var i = 0; i < list.length; i++) {
    var e = list[i];
    if (!e || e.src === null || e.dst === null || e.src === undefined || e.dst === undefined || e.src === e.dst) continue;
    var w = (e.weight === null || e.weight === undefined || !isFinite(e.weight)) ? 1 : Number(e.weight);
    if (!(w > 0)) continue;
    raw.push([idOf(e.src), idOf(e.dst), w]);
  }
  var n = names.length;
  if (n === 0) return [];

  // level graph: adjacency maps (both directions) + self loop weight of each node
  var adj = new Array(n), loops = new Array(n);
  for (i = 0; i < n; i++) { adj[i] = {}; loops[i] = 0; }
  var totalWeight = 0;
  for (i = 0; i < raw.length; i++) {
    var a = raw[i][0], b = raw[i][1], wt = raw[i][2];
    adj[a][b] = (adj[a][b] || 0) + wt;
    adj[b][a] = (adj[b][a] || 0) + wt;
    totalWeight += wt;
  }
  var m2 = 2 * totalWeight;
  var strength = new Array(n);
  for (i = 0; i < n; i++) { var s = 0; for (var k in adj[i]) s += adj[i][k]; strength[i] = s; }
  var membership = new Array(n);
  for (i = 0; i < n; i++) membership[i] = i;

  var seed = 12345;
  function rand() { seed = (seed * 1664525 + 1013904223) % 4294967296; return seed / 4294967296; }

  var size = n;
  for (var level = 0; level < levels; level++) {
    var degree = new Array(size), comm = new Array(size), tot = new Array(size);
    for (i = 0; i < size; i++) {
      var d = 2 * loops[i];
      for (var k2 in adj[i]) d += adj[i][k2];
      degree[i] = d;
      comm[i] = i;
      tot[i] = d;
    }
    var order = [];
    for (i = 0; i < size; i++) order.push(i);
    for (i = size - 1; i > 0; i--) { var r = Math.floor(rand() * (i + 1)); var tmp = order[i]; order[i] = order[r]; order[r] = tmp; }

    var anyMove = false;
    for (var pass = 0; pass < 100; pass++) {
      var moved = false;
      for (var oi = 0; oi < size; oi++) {
        var node = order[oi];
        var own = comm[node];
        var weights = {};
        for (var nb in adj[node]) {
          var j = Number(nb);
          if (j === node) continue;
          weights[comm[j]] = (weights[comm[j]] || 0) + adj[node][nb];
        }
        tot[own] -= degree[node];
        var bestComm = own;
        var bestGain = (weights[own] || 0) - tot[own] * degree[node] / m2;
        for (var cKey in weights) {
          var cc = Number(cKey);
          var gain = weights[cKey] - tot[cc] * degree[node] / m2;
          if (gain > bestGain + 1e-12) { bestGain = gain; bestComm = cc; }
        }
        tot[bestComm] += degree[node];
        if (bestComm !== own) { comm[node] = bestComm; moved = true; anyMove = true; }
      }
      if (!moved) break;
    }
    if (!anyMove) break;

    var renumber = {}, count = 0;
    for (i = 0; i < size; i++) if (renumber[comm[i]] === undefined) renumber[comm[i]] = count++;
    for (i = 0; i < n; i++) membership[i] = renumber[comm[membership[i]]];
    var newAdj = new Array(count), newSelf = new Array(count);
    for (i = 0; i < count; i++) { newAdj[i] = {}; newSelf[i] = 0; }
    for (i = 0; i < size; i++) {
      var ci = renumber[comm[i]];
      newSelf[ci] += loops[i];
      for (var nb2 in adj[i]) {
        var cj = renumber[comm[Number(nb2)]];
        if (ci === cj) newSelf[ci] += adj[i][nb2] / 2;
        else newAdj[ci][cj] = (newAdj[ci][cj] || 0) + adj[i][nb2];
      }
    }
    adj = newAdj;
    loops = newSelf;
    size = count;
    if (count === 1) break;
  }

  // modularity on the original graph: Q = sum_c [ L_c / m - (D_c / 2m)^2 ]
  var inside = {}, degreeSum = {}, members = {};
  for (i = 0; i < raw.length; i++) {
    if (membership[raw[i][0]] === membership[raw[i][1]]) inside[membership[raw[i][0]]] = (inside[membership[raw[i][0]]] || 0) + raw[i][2];
  }
  for (i = 0; i < n; i++) {
    var c2 = membership[i];
    degreeSum[c2] = (degreeSum[c2] || 0) + strength[i];
    if (!members[c2]) members[c2] = [];
    members[c2].push(i);
  }
  var Q = 0;
  for (var cKey2 in degreeSum) Q += (inside[cKey2] || 0) / totalWeight - Math.pow(degreeSum[cKey2] / m2, 2);
  var label = {};
  for (var cKey3 in members) {
    var list2 = members[cKey3];
    var top = list2[0];
    for (var x = 1; x < list2.length; x++) {
      var cand = list2[x];
      if (strength[cand] > strength[top] || (strength[cand] === strength[top] && names[cand] < names[top])) top = cand;
    }
    label[cKey3] = names[top];
  }
  var out = [];
  for (i = 0; i < n; i++) {
    out.push({ node: names[i], community: label[membership[i]], community_size: members[membership[i]].length, strength: strength[i], modularity: Q });
  }
  return out;
"""
OPTIONS (description = "Louvain communities of a weighted undirected graph")
