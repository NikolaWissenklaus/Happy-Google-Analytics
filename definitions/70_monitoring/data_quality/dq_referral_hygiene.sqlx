-- v1: 27/04/2023

config {
  type: "table",
  schema: constants.SCHEMAS.dq,
  name: "dq_referral_hygiene",
  description: "Referrals we threw away (payment gateways, 3DS pages, own domains) in the last 30 days, with sessions and revenue that would have been credited to them. Each line is a candidate for GA4 Admin > Data streams > Configure tag settings > List unwanted referrals",
  bigquery: {
    labels: { layer: "monitoring", domain: "data_quality" }
  },
  tags: ["monitoring", "data_quality", "daily", "attribution"]
}

SELECT
  excluded_referral_source AS referral_source,
  excluded_referral_reason AS reason,
  COUNT(*) AS sessions,
  SUM(transactions) AS transactions_that_would_be_stolen,
  SUM(revenue) AS revenue_that_would_be_stolen,
  APPROX_TOP_COUNT(session_default_channel_group, 3) AS channels_that_got_the_credit_back,
  MIN(session_date) AS first_seen,
  MAX(session_date) AS last_seen,
  CONCAT('Add "', excluded_referral_source, '" to the unwanted referrals of the GA4 data stream') AS action,
  CURRENT_TIMESTAMP() AS loaded_at
FROM ${ref("fct_sessions")}
WHERE session_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 30 DAY)
  AND excluded_referral_reason IS NOT NULL
GROUP BY 1, 2
