-- author: Francisco Lucas / Nikola Wissenklaus / Chico

config {
  type: "table",
  schema: constants.SCHEMAS.segments,
  name: "seg_price_sensitivity",
  description: "Price sensitivity of each customer (last 365 days): price of what they look at vs price of what they buy (relative to the category median), share of orders with coupon / discount. premium_buyer, value_seeker, discount_dependent... so the promo goes to who needs it, not to everybody",
  bigquery: {
    clusterBy: ["price_profile"],
    labels: { layer: "marts", domain: "segments" }
  },
  tags: ["marts", "segments", "daily", "pricing", "crm"],
  columns: {
    bought_price_index: "average of (price paid / median price of the category). 1.3 = buys 30% above the typical item of the category",
    price_profile: "premium_buyer | value_seeker | discount_dependent | mainstream"
  }
}

WITH
category_median AS (
  SELECT item_category, APPROX_QUANTILES(price, 2)[OFFSET(1)] AS median_price
  FROM ${ref("fct_transaction_items")}
  WHERE transaction_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 365 DAY)
    AND price > 0
  GROUP BY 1
),

purchases AS (
  SELECT
    i.user_key,
    AVG(SAFE_DIVIDE(i.price, m.median_price)) AS bought_price_index,
    COUNT(DISTINCT i.transaction_id) AS orders,
    COUNT(DISTINCT IF(i.order_coupon IS NOT NULL OR COALESCE(i.item_discount, 0) > 0, i.transaction_id, NULL)) AS discounted_orders
  FROM ${ref("fct_transaction_items")} AS i
  JOIN category_median AS m USING (item_category)
  WHERE i.transaction_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 365 DAY)
    AND i.is_valid_for_revenue
    AND i.price > 0
  GROUP BY i.user_key
)

SELECT
  *,
  SAFE_DIVIDE(discounted_orders, orders) AS discounted_order_share,
  CASE
    WHEN SAFE_DIVIDE(discounted_orders, orders) >= 0.75 AND orders >= 2 THEN 'discount_dependent'
    WHEN bought_price_index >= 1.3 THEN 'premium_buyer'
    WHEN bought_price_index <= 0.7 THEN 'value_seeker'
    ELSE 'mainstream'
  END AS price_profile,
  CURRENT_TIMESTAMP() AS loaded_at
FROM purchases
