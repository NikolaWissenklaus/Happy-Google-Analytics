-- author: Francisco Lucas / Nikola Wissenklaus / Chico

config {
  type: "table",
  schema: constants.SCHEMAS.dq,
  name: "dq_hostname_governance",
  description: "Every hostname that sent data in the last 30 days: expected production host, non production (staging, localhost, vercel previews, google translate proxy, web archive) or unknown (ghost spam / someone copied your tag). With volume and first/last seen",
  bigquery: {
    labels: { layer: "monitoring", domain: "data_quality" }
  },
  tags: ["monitoring", "data_quality", "daily", "tracking"],
  columns: {
    host_status: "production | non_production | unknown"
  }
}

SELECT
  COALESCE(hostname, '(not set)') AS hostname,
  CASE
    WHEN ${helpers.inList("hostname", constants.SITE_HOSTNAMES)} THEN 'production'
    WHEN is_non_production_host THEN 'non_production'
    ELSE 'unknown'
  END AS host_status,
  COUNT(*) AS events,
  COUNT(DISTINCT session_key) AS sessions,
  COUNTIF(event_name = 'purchase') AS purchases,
  MIN(event_date) AS first_seen,
  MAX(event_date) AS last_seen,
  CURRENT_TIMESTAMP() AS loaded_at
FROM ${ref("stg_ga4__events")}
WHERE event_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 30 DAY)
  AND platform = 'WEB'
GROUP BY 1, 2
