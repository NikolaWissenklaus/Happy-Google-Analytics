-- v1: 10/05/2024

config {
  type: "table",
  schema: constants.SCHEMAS.core,
  name: "fct_transaction_items",
  description: "One row per item sold (deduplicated transactions only), with the transaction context. Product revenue, units, coupons, category mix",
  bigquery: {
    partitionBy: "transaction_date",
    clusterBy: ["item_id", "item_category"],
    labels: { layer: "core", domain: "ecommerce" }
  },
  tags: ["ga4", "core", "daily", "ecommerce"],
  columns: {
    item_revenue: "Item revenue (item_revenue, else price * quantity)",
    item_share_of_order: "item_revenue / sum of item revenue of the order, to split order level things (shipping, discount) by item"
  }
}

WITH unnest_items AS (
  SELECT
    t.transaction_id,
    t.transaction_date,
    t.transaction_ts,
    t.session_key,
    t.user_key,
    t.currency,
    t.coupon AS order_coupon,
    t.payment_type,
    t.session_default_channel_group,
    t.session_custom_channel_group,
    t.session_source,
    t.session_medium,
    t.session_campaign,
    t.device_category,
    t.geo_uf,
    t.order_number,
    t.is_first_purchase,
    t.is_test_transaction,
    t.is_valid_for_revenue,
    pos AS item_position,
    i.item_id,
    i.item_name,
    i.item_brand,
    i.item_variant,
    i.item_category,
    i.item_category2,
    i.item_category3,
    i.price,
    i.quantity,
    i.item_revenue,
    i.item_coupon,
    i.item_list_name,
    i.affiliation,
    i.item_discount
  FROM ${ref("fct_transactions")} AS t,
    UNNEST(t.items) AS i WITH OFFSET AS pos
)

SELECT
  *,
  SAFE_DIVIDE(item_revenue, SUM(item_revenue) OVER (PARTITION BY transaction_id)) AS item_share_of_order,
  COUNT(*) OVER (PARTITION BY transaction_id) AS lines_in_order,
  CURRENT_TIMESTAMP() AS loaded_at
FROM unnest_items
