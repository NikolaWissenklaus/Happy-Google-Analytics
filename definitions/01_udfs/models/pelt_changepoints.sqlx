-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 17/11/2026

config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.udf,
  name: "pelt_changepoints",
  description: "Change points of a series (PELT, Killick, Fearnhead & Eckley 2012): splits the series in regimes with different means and returns each regime with start / end index, mean and sd. Exact optimal segmentation in linear time, penalty = multiplier x 2 ln(n) (1 = BIC)",
  dependencies: ["ops_bootstrap_datasets"],
  tags: ["udf", "daily", "models", "insights"]
}

-- "conversion was 2.1% until march, 1.6% after the new checkout, 1.9% since june" is a sentence
-- about regimes, and averages over a fixed window never say it. PELT finds the segmentation that
-- minimizes sum(cost of each segment) + penalty x number of segments, exactly, pruning the
-- candidates that can never win. The cost is the gaussian change in mean with the noise level
-- estimated robustly from the first differences (median |diff| / (0.6745 sqrt 2)). Before the
-- segmentation every point is clipped to 3 sigma around the median of its neighbourhood (a window
-- of min_segment_length points), so one outlier day never becomes a regime but a level that stays
-- does. mean / sd of each regime are of the ORIGINAL values. Send a deseasonalized series without
-- NULLs (arrays in BigQuery cannot have NULL elements). Indexes are 0 based. FLOAT64 because JS
-- UDFs do not take INT64
CREATE OR REPLACE FUNCTION ${self()}(series ARRAY<FLOAT64>, penalty_multiplier FLOAT64, min_segment_length FLOAT64)
RETURNS ARRAY<STRUCT<segment FLOAT64, start_index FLOAT64, end_index FLOAT64, points FLOAT64, mean FLOAT64, sd FLOAT64, noise_sigma FLOAT64>>
LANGUAGE js AS r"""
  var input = series || [];
  var x = [];
  var lastGood = null;
  for (var i = 0; i < input.length; i++) {
    var v = input[i];
    if (v === null || v === undefined || isNaN(v) || !isFinite(v)) {
      x.push(lastGood === null ? 0 : lastGood);
    } else {
      x.push(Number(v));
      lastGood = Number(v);
    }
  }
  var n = x.length;
  if (n === 0) return [];
  var mult = (penalty_multiplier === null || penalty_multiplier === undefined || !(penalty_multiplier > 0)) ? 1 : penalty_multiplier;
  var minLen = (min_segment_length === null || min_segment_length === undefined) ? 7 : Math.max(2, Math.round(min_segment_length));

  function median(arr) {
    if (arr.length === 0) return 0;
    var s = arr.slice().sort(function (a, b) { return a - b; });
    var mid = Math.floor(s.length / 2);
    return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
  }
  function stats(a, b) {
    var m = b - a, sum = 0, sq = 0;
    for (var k = a; k < b; k++) { sum += x[k]; sq += x[k] * x[k]; }
    var mean = sum / m;
    var variance = m > 1 ? Math.max(0, (sq - sum * sum / m) / (m - 1)) : 0;
    return { mean: mean, sd: Math.sqrt(variance) };
  }

  var diffs = [];
  for (i = 1; i < n; i++) diffs.push(Math.abs(x[i] - x[i - 1]));
  var sigma = median(diffs) / (0.6744897501960817 * Math.SQRT2);
  if (!(sigma > 0)) sigma = stats(0, n).sd;
  var single = stats(0, n);
  if (!(sigma > 0) || n < 2 * minLen) {
    return [{ segment: 1, start_index: 0, end_index: n - 1, points: n, mean: single.mean, sd: single.sd, noise_sigma: sigma > 0 ? sigma : 0 }];
  }
  var sigma2 = sigma * sigma;

  // robust copy for the segmentation: clip to median +- 3 sigma of the centered window
  var half = Math.floor(minLen / 2);
  var y = new Array(n);
  for (i = 0; i < n; i++) {
    var from = Math.max(0, i - half), to = Math.min(n, i + half + 1);
    var local = median(x.slice(from, to));
    y[i] = Math.min(Math.max(x[i], local - 3 * sigma), local + 3 * sigma);
  }

  var s1 = [0], s2 = [0];
  for (i = 0; i < n; i++) { s1.push(s1[i] + y[i]); s2.push(s2[i] + y[i] * y[i]); }
  // cost of the segment x[a..b-1] = sum of squares around its own mean, in units of the noise
  function cost(a, b) {
    var m = b - a;
    var sum = s1[b] - s1[a];
    var c = ((s2[b] - s2[a]) - sum * sum / m) / sigma2;
    return c < 0 ? 0 : c;
  }

  var beta = mult * 2 * Math.log(n);
  var F = new Array(n + 1);
  var last = new Array(n + 1);
  F[0] = -beta;
  last[0] = 0;
  var R = [0];
  for (var t = 1; t <= n; t++) {
    var best = Infinity, bestTau = 0;
    for (var r = 0; r < R.length; r++) {
      var tau = R[r];
      if (t - tau < minLen || !isFinite(F[tau])) continue;
      var val = F[tau] + cost(tau, t) + beta;
      if (val < best) { best = val; bestTau = tau; }
    }
    F[t] = best;
    last[t] = bestTau;
    // PELT pruning: a candidate that is already worse than the optimum never comes back (K = 0 for this cost)
    var keep = [];
    for (r = 0; r < R.length; r++) {
      tau = R[r];
      if (t - tau < minLen) { keep.push(tau); continue; }
      if (isFinite(F[tau]) && F[tau] + cost(tau, t) <= F[t]) keep.push(tau);
    }
    keep.push(t);
    R = keep;
  }

  if (!isFinite(F[n])) {
    return [{ segment: 1, start_index: 0, end_index: n - 1, points: n, mean: single.mean, sd: single.sd, noise_sigma: sigma }];
  }
  var bounds = [];
  var end = n;
  while (end > 0) {
    var start = last[end];
    bounds.unshift([start, end]);
    if (start >= end) break;
    end = start;
  }
  var out = [];
  for (var j = 0; j < bounds.length; j++) {
    var st = stats(bounds[j][0], bounds[j][1]);
    out.push({ segment: j + 1, start_index: bounds[j][0], end_index: bounds[j][1] - 1, points: bounds[j][1] - bounds[j][0], mean: st.mean, sd: st.sd, noise_sigma: sigma });
  }
  return out;
"""
OPTIONS (description = "PELT change points (gaussian change in mean, robust noise level)")
