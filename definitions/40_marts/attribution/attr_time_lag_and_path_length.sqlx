-- v1: 13/08/2020

config {
  type: "table",
  schema: constants.SCHEMAS.attribution,
  name: "attr_time_lag_and_path_length",
  description: "UA MCF 'Time Lag' and 'Path Length' reports in one table (metric = time_lag | path_length), last 90 days. How long and how many touches people need to buy. Long lag = remarketing window must be long too",
  bigquery: {
    labels: { layer: "marts", domain: "attribution" }
  },
  tags: ["marts", "attribution", "daily", "ua_report"]
}

WITH
paths AS (
  SELECT *
  FROM ${ref("attr_conversion_paths")}
  WHERE conversion_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 90 DAY)
),

buckets AS (
  SELECT
    key_event_name,
    'time_lag' AS report,
    CASE
      WHEN time_lag_days < 1 THEN '0 days'
      WHEN time_lag_days < 12 THEN CONCAT(CAST(CAST(FLOOR(time_lag_days) AS INT64) AS STRING), ' days')
      WHEN time_lag_days < 31 THEN '12-30 days'
      WHEN time_lag_days < 61 THEN '31-60 days'
      ELSE '61-90 days'
    END AS bucket,
    CASE
      WHEN time_lag_days < 12 THEN CAST(FLOOR(time_lag_days) AS INT64)
      WHEN time_lag_days < 31 THEN 12
      WHEN time_lag_days < 61 THEN 31
      ELSE 61
    END AS bucket_order,
    conversion_value
  FROM paths
  UNION ALL
  SELECT
    key_event_name,
    'path_length' AS report,
    IF(path_length >= 12, '12+ touches', CONCAT(CAST(path_length AS STRING), ' touches')) AS bucket,
    LEAST(path_length, 12) AS bucket_order,
    conversion_value
  FROM paths
)

SELECT
  key_event_name,
  report,
  bucket,
  bucket_order,
  COUNT(*) AS conversions,
  SUM(conversion_value) AS conversion_value,
  SAFE_DIVIDE(COUNT(*), SUM(COUNT(*)) OVER (PARTITION BY key_event_name, report)) AS share_of_conversions,
  CURRENT_TIMESTAMP() AS loaded_at
FROM buckets
GROUP BY 1, 2, 3, 4
