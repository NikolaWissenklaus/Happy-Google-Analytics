-- v1: 17/11/2026

config {
  type: "table",
  schema: constants.SCHEMAS.attribution,
  name: "attr_channel_by_model_extended",
  description: "Same long format of attr_channel_by_model (month x key event x channel x model) for the 10 models of attr_credits_rule_based_extended. UNION it with attr_channel_by_model and the BI has 17 rule based models as one dimension",
  bigquery: {
    labels: { layer: "marts", domain: "attribution" }
  },
  tags: ["marts", "attribution", "daily", "attribution_extended"]
}

WITH credited AS (
  SELECT
    DATE_TRUNC(c.conversion_date, MONTH) AS conversion_month,
    c.key_event_name,
    c.channel,
    m.model,
    SUM(m.credit) AS attributed_conversions,
    SUM(m.credit * c.conversion_value) AS attributed_value
  FROM ${ref("attr_credits_rule_based_extended")} AS c,
    UNNEST([
      STRUCT('first_non_direct' AS model, c.credit_first_non_direct AS credit),
      STRUCT('last_paid', c.credit_last_paid),
      STRUCT('last_engaged', c.credit_last_engaged),
      STRUCT('j_shaped', c.credit_j_shaped),
      STRUCT('inverse_j', c.credit_inverse_j),
      STRUCT('full_path', c.credit_full_path),
      STRUCT('engagement_weighted', c.credit_engagement_weighted),
      STRUCT('geometric_position', c.credit_geometric_position),
      STRUCT('funnel_progress', c.credit_funnel_progress),
      STRUCT('learned_time_decay', c.credit_learned_time_decay)
    ]) AS m
  GROUP BY 1, 2, 3, 4
)

SELECT
  *,
  SAFE_DIVIDE(attributed_conversions, SUM(attributed_conversions) OVER (PARTITION BY conversion_month, key_event_name, model)) AS share_of_conversions,
  CURRENT_TIMESTAMP() AS loaded_at
FROM credited
