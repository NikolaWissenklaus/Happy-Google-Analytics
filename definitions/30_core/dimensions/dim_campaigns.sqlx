-- author: Francisco Lucas / Nikola Wissenklaus / Chico

config {
  type: "table",
  schema: constants.SCHEMAS.core,
  name: "dim_campaigns",
  description: "Every campaign seen in GA4 (session campaign) with source/medium, channel, ad platform, brand flag, ids and lifetime performance",
  bigquery: {
    labels: { layer: "core", domain: "attribution" }
  },
  tags: ["ga4", "core", "daily", "attribution"],
  columns: {
    ad_platform: "google_ads / meta_ads / microsoft_ads / tiktok_ads / other_paid / not_paid",
    is_brand_campaign: "Campaign name has one of cfg_project.brand_terms"
  }
}

WITH campaign_sessions AS (
  SELECT
    LOWER(session_campaign) AS campaign,
    session_source,
    session_medium,
    session_default_channel_group,
    session_custom_channel_group,
    session_campaign_id,
    google_ads_campaign_id,
    session_date,
    is_new_user,
    transactions,
    revenue
  FROM ${ref("fct_sessions")}
  WHERE session_campaign IS NOT NULL
    AND LOWER(session_campaign) NOT IN ('(not set)', '(direct)', '(organic)', '(referral)')
)

SELECT
  campaign,
  session_source,
  session_medium,
  ANY_VALUE(session_default_channel_group) AS default_channel_group,
  ANY_VALUE(session_custom_channel_group) AS custom_channel_group,
  CASE
    WHEN session_source = 'google' AND session_medium = 'cpc' THEN 'google_ads'
    WHEN session_source IN ('facebook', 'instagram', 'meta', 'fb', 'ig', 'an', 'messenger', 'threads') AND REGEXP_CONTAINS(session_medium, r'${channels.PAID_MEDIUM}') THEN 'meta_ads'
    WHEN session_source = 'bing' AND session_medium = 'cpc' THEN 'microsoft_ads'
    WHEN session_source = 'tiktok' AND REGEXP_CONTAINS(session_medium, r'${channels.PAID_MEDIUM}') THEN 'tiktok_ads'
    WHEN REGEXP_CONTAINS(session_medium, r'${channels.PAID_MEDIUM}') THEN 'other_paid'
    ELSE 'not_paid'
  END AS ad_platform,
  REGEXP_CONTAINS(campaign, r'(?i)${helpers.regexFromList(cfg_project.brand_terms, false)}') AS is_brand_campaign,
  ANY_VALUE(session_campaign_id) AS campaign_id,
  ANY_VALUE(google_ads_campaign_id) AS google_ads_campaign_id,
  MIN(session_date) AS first_seen_date,
  MAX(session_date) AS last_seen_date,
  COUNT(*) AS lifetime_sessions,
  COUNTIF(is_new_user) AS lifetime_new_users,
  SUM(transactions) AS lifetime_transactions,
  SUM(revenue) AS lifetime_revenue,
  CURRENT_TIMESTAMP() AS loaded_at
FROM campaign_sessions
GROUP BY campaign, session_source, session_medium
