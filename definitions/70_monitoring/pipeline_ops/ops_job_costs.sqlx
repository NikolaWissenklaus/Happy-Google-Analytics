-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 27/09/2024

config {
  type: "table",
  schema: constants.SCHEMAS.ops,
  name: "ops_job_costs",
  description: "What each model costs: BigQuery jobs of the last days that wrote into our datasets (the Dataform runs), per destination table and day, with bytes billed, slot hours, estimated on demand USD and duration. Needs bigquery.jobs.listAll on the project (JOBS_BY_PROJECT)",
  bigquery: {
    partitionBy: "job_date",
    labels: { layer: "monitoring", domain: "ops" }
  },
  tags: ["ops", "daily"],
  columns: {
    estimated_usd: "bytes billed * cfg_project.bigquery.on_demand_usd_per_tib. With editions / reservations use slot_hours instead",
    destination: "dataset.table written by the job (operations without destination show as '(script)')"
  }
}

js {
  const bq = cfg_project.bigquery;
}

SELECT
  DATE(creation_time, '${constants.TIMEZONE}') AS job_date,
  IF(destination_table.table_id IS NULL, '(script)', CONCAT(destination_table.dataset_id, '.', destination_table.table_id)) AS destination,
  statement_type,
  COUNT(*) AS jobs,
  COUNTIF(error_result IS NOT NULL) AS failed_jobs,
  SUM(total_bytes_billed) AS bytes_billed,
  ROUND(SUM(total_bytes_billed) / POW(1024, 4) * ${bq.on_demand_usd_per_tib}, 4) AS estimated_usd,
  ROUND(SUM(total_slot_ms) / 1000 / 3600, 3) AS slot_hours,
  ROUND(AVG(TIMESTAMP_DIFF(end_time, start_time, SECOND)), 1) AS avg_duration_sec,
  MAX(TIMESTAMP_DIFF(end_time, start_time, SECOND)) AS max_duration_sec,
  CURRENT_TIMESTAMP() AS loaded_at
FROM ${constants.regionTable("JOBS_BY_PROJECT")}
WHERE creation_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL ${bq.jobs_history_days} DAY)
  AND job_type = 'QUERY'
  AND (
    STARTS_WITH(destination_table.dataset_id, '${constants.SCHEMA_PREFIX}_')
    -- scripts (incremental pre operations, UDFs, LGPD ops) have no destination, the query text tells
    OR (destination_table.dataset_id IS NULL AND REGEXP_CONTAINS(query, r'${constants.PROJECT}\.${constants.SCHEMA_PREFIX}_'))
  )
  AND (statement_type IS NULL OR statement_type != 'SCRIPT')
GROUP BY 1, 2, 3
