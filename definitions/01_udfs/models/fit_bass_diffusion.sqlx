-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 17/11/2026

config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.udf,
  name: "fit_bass_diffusion",
  description: "Bass diffusion model (1969) fitted to the new adopters per period: p (innovation, people that come by themselves / by the ads), q (imitation, people that come because others adopted), m (size of the market), peak period, share of the market already reached and the forecast of the next periods",
  dependencies: ["ops_bootstrap_datasets"],
  tags: ["udf", "daily", "models", "insights"]
}

-- How does a new product spread? Frank Bass answered in 1969 with two forces: p, the innovators
-- that adopt alone, and q, the imitators that adopt because others did. Cumulative adoption:
--   F(t) = (1 - exp(-(p + q) t)) / (1 + (q / p) exp(-(p + q) t)),   new adopters(t) = m (F(t) - F(t-1))
-- q / p of 10+ = word of mouth product (the peak comes later and higher), q < p = a product pushed by
-- media that fades when the push stops. p and q by grid search + Nelder-Mead on the squared error,
-- m by least squares for each (p, q), never below the adopters already seen (m_at_lower_bound says
-- when that happened: the curve did not show its peak yet and m is a floor). Periods are equal
-- (weeks are better than days), the first value is the first period after the launch
CREATE OR REPLACE FUNCTION ${self()}(adoptions ARRAY<FLOAT64>, horizon FLOAT64)
RETURNS STRUCT<p FLOAT64, q FLOAT64, m FLOAT64, sse FLOAT64, r2 FLOAT64, peak_period FLOAT64, peak_adoptions FLOAT64, adopters_so_far FLOAT64, share_of_market_reached FLOAT64, m_at_lower_bound BOOL, forecast ARRAY<FLOAT64>>
LANGUAGE js AS r"""
  var y = [];
  var raw = adoptions || [];
  for (var i = 0; i < raw.length; i++) {
    var v = raw[i];
    y.push((v === null || v === undefined || !isFinite(v) || v < 0) ? 0 : Number(v));
  }
  var T = y.length;
  var cum = 0;
  for (i = 0; i < T; i++) cum += y[i];
  if (T < 3 || !(cum > 0)) return null;
  var H = (horizon === null || horizon === undefined) ? 8 : Math.max(0, Math.round(horizon));

  function F(t, p, q) {
    var e = Math.exp(-(p + q) * t);
    return (1 - e) / (1 + (q / p) * e);
  }
  function evaluate(p, q) {
    if (!(p > 0) || q < 0) return { sse: Infinity };
    var f = new Array(T), prev = 0, yf = 0, ff = 0;
    for (var t = 1; t <= T; t++) {
      var cur = F(t, p, q);
      f[t - 1] = cur - prev;
      prev = cur;
      yf += y[t - 1] * f[t - 1];
      ff += f[t - 1] * f[t - 1];
    }
    if (!(ff > 0)) return { sse: Infinity };
    var m = yf / ff;
    var bound = false;
    if (!(m >= cum)) { m = cum; bound = true; }
    var sse = 0;
    for (t = 0; t < T; t++) sse += (y[t] - m * f[t]) * (y[t] - m * f[t]);
    return { sse: sse, m: m, bound: bound };
  }

  var best = null;
  for (var ip = 0; ip <= 30; ip++) {
    var p = Math.exp(Math.log(1e-4) + ip * (Math.log(0.3) - Math.log(1e-4)) / 30);
    for (var iq = 0; iq <= 30; iq++) {
      var q = iq * 0.05;
      var ev = evaluate(p, q);
      if (best === null || ev.sse < best.sse) best = { sse: ev.sse, lp: Math.log(p), q: q };
    }
  }

  // Nelder-Mead on (ln p, q) from the best point of the grid
  function f2(pt) { return evaluate(Math.exp(pt[0]), Math.max(0, pt[1])).sse; }
  var simplex = [[best.lp, best.q], [best.lp + 0.3, best.q], [best.lp, best.q + 0.05]];
  var values = simplex.map(f2);
  for (var it = 0; it < 300; it++) {
    var idx = [0, 1, 2].sort(function (a, b) { return values[a] - values[b]; });
    simplex = idx.map(function (k) { return simplex[k]; });
    values = idx.map(function (k) { return values[k]; });
    if (Math.abs(values[2] - values[0]) <= 1e-12 * (Math.abs(values[0]) + 1e-12)) break;
    var cx = [(simplex[0][0] + simplex[1][0]) / 2, (simplex[0][1] + simplex[1][1]) / 2];
    var xr = [cx[0] + (cx[0] - simplex[2][0]), cx[1] + (cx[1] - simplex[2][1])];
    var fr = f2(xr);
    if (fr < values[0]) {
      var xe = [cx[0] + 2 * (cx[0] - simplex[2][0]), cx[1] + 2 * (cx[1] - simplex[2][1])];
      var fe = f2(xe);
      if (fe < fr) { simplex[2] = xe; values[2] = fe; } else { simplex[2] = xr; values[2] = fr; }
    } else if (fr < values[1]) {
      simplex[2] = xr; values[2] = fr;
    } else {
      var xc = [cx[0] + 0.5 * (simplex[2][0] - cx[0]), cx[1] + 0.5 * (simplex[2][1] - cx[1])];
      var fc = f2(xc);
      if (fc < values[2]) { simplex[2] = xc; values[2] = fc; }
      else {
        for (var s = 1; s < 3; s++) {
          simplex[s] = [simplex[0][0] + 0.5 * (simplex[s][0] - simplex[0][0]), simplex[0][1] + 0.5 * (simplex[s][1] - simplex[0][1])];
          values[s] = f2(simplex[s]);
        }
      }
    }
  }
  var bi = values[0] <= best.sse ? 0 : -1;
  var pFit = bi === 0 ? Math.exp(simplex[0][0]) : Math.exp(best.lp);
  var qFit = bi === 0 ? Math.max(0, simplex[0][1]) : best.q;
  var fit = evaluate(pFit, qFit);

  var mean = cum / T, sst = 0;
  for (i = 0; i < T; i++) sst += (y[i] - mean) * (y[i] - mean);
  var peak = qFit > pFit ? Math.log(qFit / pFit) / (pFit + qFit) : 0;
  var peakAdoptions = qFit > pFit ? fit.m * (pFit + qFit) * (pFit + qFit) / (4 * qFit) : fit.m * pFit;
  var forecast = [];
  for (var k = 1; k <= H; k++) forecast.push(fit.m * (F(T + k, pFit, qFit) - F(T + k - 1, pFit, qFit)));
  return {
    p: pFit, q: qFit, m: fit.m, sse: fit.sse,
    r2: sst > 0 ? 1 - fit.sse / sst : null,
    peak_period: peak, peak_adoptions: peakAdoptions,
    adopters_so_far: cum, share_of_market_reached: fit.m > 0 ? cum / fit.m : null,
    m_at_lower_bound: fit.bound === true,
    forecast: forecast
  };
"""
OPTIONS (description = "Bass diffusion model: innovation p, imitation q, market m")
