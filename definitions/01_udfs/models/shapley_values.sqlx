-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 22/02/2020

config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.udf,
  name: "shapley_values",
  description: "Shapley value attribution (cooperative game theory) over the channel sets of the converting paths",
  dependencies: ["ops_bootstrap_datasets"],
  tags: ["udf", "daily", "attribution"]
}

-- each converting path is a "coalition" = the SET of channels in it (order does not matter).
-- worth v(S) = conversions of all coalitions contained in S. then the classic formula:
--   phi_i = sum over S without i of |S|! (n-|S|-1)! / n! * (v(S + i) - v(S))
-- computed for all 2^n subsets with a subset-sum (zeta) transform, so it is exact, no sampling.
-- n is capped (max_channels, default 14) and the rest goes to "(other)", 2^15 is still fast.
-- sum of all shapley values = total conversions, nice property for reports.
CREATE OR REPLACE FUNCTION ${self()}(
  coalitions ARRAY<STRUCT<channels ARRAY<STRING>, conversions FLOAT64>>,
  max_channels FLOAT64
)
RETURNS ARRAY<STRUCT<channel STRING, shapley_value FLOAT64>>
LANGUAGE js AS r"""
  var cap = Math.max(1, Math.min(15, Math.floor(max_channels || 14)));
  var totals = {};
  (coalitions || []).forEach(function (c) {
    if (!c || !c.channels) return;
    var seen = {};
    c.channels.forEach(function (ch) {
      if (ch === null || ch === undefined || seen[ch]) return;
      seen[ch] = true;
      totals[ch] = (totals[ch] || 0) + (c.conversions || 0);
    });
  });
  var ranked = Object.keys(totals).sort(function (a, b) { return totals[b] - totals[a]; });
  if (ranked.length === 0) return [];
  var players = ranked.slice(0, cap);
  var hasOther = ranked.length > cap;
  if (hasOther) players.push('(other)');
  var index = {};
  players.forEach(function (p, i) { index[p] = i; });
  var n = players.length;
  var size = 1 << n;
  var worth = new Float64Array(size);

  (coalitions || []).forEach(function (c) {
    if (!c || !c.channels) return;
    var mask = 0;
    c.channels.forEach(function (ch) {
      if (ch === null || ch === undefined) return;
      var k = (ch in index) ? index[ch] : index['(other)'];
      mask |= (1 << k);
    });
    if (mask > 0) worth[mask] += (c.conversions || 0);
  });

  // zeta transform: worth[S] = sum of conversions of every coalition inside S
  for (var i = 0; i < n; i++) {
    var bit = 1 << i;
    for (var mask = 0; mask < size; mask++) {
      if (mask & bit) worth[mask] += worth[mask ^ bit];
    }
  }

  var fact = [1];
  for (var k = 1; k <= n; k++) fact.push(fact[k - 1] * k);
  function popcount(v) { var c = 0; while (v) { v &= v - 1; c++; } return c; }

  var phi = [];
  for (var p = 0; p < n; p++) phi.push(0);
  for (var s = 0; s < size; s++) {
    var sizeS = popcount(s);
    var weight = fact[sizeS] * fact[n - sizeS - 1] / fact[n];
    for (var j = 0; j < n; j++) {
      var b = 1 << j;
      if (s & b) continue;
      phi[j] += weight * (worth[s | b] - worth[s]);
    }
  }
  return players.map(function (pl, i) { return { channel: pl, shapley_value: phi[i] }; });
"""
OPTIONS (description = "Exact Shapley values for channel attribution")
