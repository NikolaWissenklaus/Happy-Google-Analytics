config {
  type: "table",
  schema: constants.SCHEMAS.attribution,
  name: "attr_channel_by_model",
  description: "Conversions and value credited to each channel by each rule based model, by month and key event. Long format, great for BI filters (model as a dimension)",
  bigquery: {
    labels: { layer: "marts", domain: "attribution" }
  },
  tags: ["marts", "attribution", "daily"]
}

WITH credited AS (
  SELECT
    DATE_TRUNC(c.conversion_date, MONTH) AS conversion_month,
    c.key_event_name,
    c.channel,
    m.model,
    SUM(m.credit) AS attributed_conversions,
    SUM(m.credit * c.conversion_value) AS attributed_value
  FROM ${ref("attr_credits_rule_based")} AS c,
    UNNEST([
      STRUCT('first_click' AS model, c.credit_first_click AS credit),
      STRUCT('last_click', c.credit_last_click),
      STRUCT('last_non_direct', c.credit_last_non_direct),
      STRUCT('linear', c.credit_linear),
      STRUCT('time_decay', c.credit_time_decay),
      STRUCT('position_based', c.credit_position_based),
      STRUCT('w_shaped', c.credit_w_shaped)
    ]) AS m
  GROUP BY 1, 2, 3, 4
)

SELECT
  *,
  SAFE_DIVIDE(attributed_conversions, SUM(attributed_conversions) OVER (PARTITION BY conversion_month, key_event_name, model)) AS share_of_conversions,
  CURRENT_TIMESTAMP() AS loaded_at
FROM credited
