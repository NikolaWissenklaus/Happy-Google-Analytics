-- author: Francisco Lucas / Nikola Wissenklaus / Chico

config {
  type: "table",
  schema: constants.SCHEMAS.dq,
  name: "dq_export_freshness",
  description: "Is the GA4 export alive? One row with the latest daily shard, hours since it was created, missing days in the last 30, latest intraday, and the status (ok / late / broken). The first thing to look at when 'the dashboard is wrong'",
  bigquery: {
    labels: { layer: "monitoring", domain: "data_quality" }
  },
  tags: ["monitoring", "data_quality", "daily", "alerts"],
  columns: {
    status: "ok = yesterday shard exists | late = only 2 days ago | broken = 3+ days without a daily shard"
  }
}

WITH
daily AS (
  SELECT shard_date, created_at, row_count FROM ${ref("dq_source_shards")} WHERE shard_type = 'daily'
),

intraday AS (
  SELECT MAX(shard_date) AS latest_intraday_date, MAX(last_modified_at) AS latest_intraday_update
  FROM ${ref("dq_source_shards")} WHERE shard_type = 'intraday'
),

expected_days AS (
  SELECT d FROM UNNEST(GENERATE_DATE_ARRAY(DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 30 DAY), DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 2 DAY))) AS d
)

SELECT
  (SELECT MAX(shard_date) FROM daily) AS latest_daily_shard,
  (SELECT MAX(created_at) FROM daily) AS latest_daily_created_at,
  TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), (SELECT MAX(created_at) FROM daily), MINUTE) / 60 AS hours_since_last_daily,
  DATE_DIFF(CURRENT_DATE('${constants.TIMEZONE}'), (SELECT MAX(shard_date) FROM daily), DAY) AS days_behind,
  (SELECT COUNT(*) FROM expected_days AS e LEFT JOIN daily AS d ON d.shard_date = e.d WHERE d.shard_date IS NULL) AS missing_days_last_30,
  (SELECT ARRAY_AGG(e.d ORDER BY e.d) FROM expected_days AS e LEFT JOIN daily AS d ON d.shard_date = e.d WHERE d.shard_date IS NULL) AS missing_dates,
  (SELECT COUNTIF(row_count = 0) FROM daily WHERE shard_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 30 DAY)) AS empty_shards_last_30,
  i.latest_intraday_date,
  i.latest_intraday_update,
  TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), i.latest_intraday_update, MINUTE) AS minutes_since_intraday_update,
  CASE
    WHEN DATE_DIFF(CURRENT_DATE('${constants.TIMEZONE}'), (SELECT MAX(shard_date) FROM daily), DAY) <= 1 THEN 'ok'
    WHEN DATE_DIFF(CURRENT_DATE('${constants.TIMEZONE}'), (SELECT MAX(shard_date) FROM daily), DAY) = 2 THEN 'late'
    ELSE 'broken'
  END AS status,
  CURRENT_TIMESTAMP() AS checked_at
FROM intraday AS i
