-- v1: 18/12/2019

config {
  type: "table",
  schema: constants.SCHEMAS.attribution,
  name: "attr_campaign_by_model",
  description: "Same as attr_channel_by_model but at source / medium / campaign level, wide (one column per model). Paste it next to the costs and you have ROAS by model",
  bigquery: {
    labels: { layer: "marts", domain: "attribution" }
  },
  tags: ["marts", "attribution", "daily"]
}

SELECT
  DATE_TRUNC(conversion_date, MONTH) AS conversion_month,
  key_event_name,
  channel,
  source_medium,
  campaign,
  SUM(credit_first_click) AS conv_first_click,
  SUM(credit_last_click) AS conv_last_click,
  SUM(credit_last_non_direct) AS conv_last_non_direct,
  SUM(credit_linear) AS conv_linear,
  SUM(credit_time_decay) AS conv_time_decay,
  SUM(credit_position_based) AS conv_position_based,
  SUM(credit_w_shaped) AS conv_w_shaped,
  SUM(credit_last_non_direct * conversion_value) AS value_last_non_direct,
  SUM(credit_linear * conversion_value) AS value_linear,
  SUM(credit_time_decay * conversion_value) AS value_time_decay,
  SUM(credit_position_based * conversion_value) AS value_position_based,
  COUNT(DISTINCT conversion_id) AS conversions_touched,
  CURRENT_TIMESTAMP() AS loaded_at
FROM ${ref("attr_credits_rule_based")}
GROUP BY 1, 2, 3, 4, 5
