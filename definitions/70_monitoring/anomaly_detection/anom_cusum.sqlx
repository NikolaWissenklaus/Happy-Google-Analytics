-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 26/06/2022

config {
  type: "table",
  schema: constants.SCHEMAS.anomaly,
  name: "anom_cusum",
  description: "Method 6 - two sided tabular CUSUM (JS UDF) over the z-scores of the last 120 days (56 day baseline). Catches small persistent shifts: conversion -8% for 10 days after a deploy never breaks a z-score, but CUSUM accumulates it and fires",
  bigquery: {
    partitionBy: "metric_date",
    clusterBy: ["metric", "breakdown"],
    labels: { layer: "monitoring", domain: "anomaly" }
  },
  tags: ["monitoring", "anomaly", "daily"]
}

WITH
standardized AS (
  SELECT
    *,
    SAFE_DIVIDE(value - AVG(value) OVER w, STDDEV_SAMP(value) OVER w) AS z,
    AVG(value) OVER w AS expected
  FROM ${ref("anom_metric_series_daily")}
  WINDOW w AS (PARTITION BY metric, breakdown, breakdown_value ORDER BY UNIX_DATE(metric_date) RANGE BETWEEN ${cfg_anomaly.cusum.baseline_days} PRECEDING AND 1 PRECEDING)
),

per_series AS (
  SELECT
    metric,
    breakdown,
    breakdown_value,
    ARRAY_AGG(STRUCT(metric_date, value, expected) ORDER BY metric_date) AS points,
    ARRAY_AGG(COALESCE(z, 0) ORDER BY metric_date) AS z_values
  FROM standardized
  WHERE metric_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 120 DAY)
  GROUP BY 1, 2, 3
),

run_cusum AS (
  SELECT
    p.metric,
    p.breakdown,
    p.breakdown_value,
    p.points,
    ${ref("cusum")}(p.z_values, ${cfg_anomaly.cusum.k}, ${cfg_anomaly.cusum.h}) AS cusum_values
  FROM per_series AS p
)

SELECT
  r.points[OFFSET(pos)].metric_date AS metric_date,
  r.metric,
  r.breakdown,
  r.breakdown_value,
  r.points[OFFSET(pos)].value AS value,
  r.points[OFFSET(pos)].expected AS expected,
  CAST(NULL AS FLOAT64) AS lower_bound,
  CAST(NULL AS FLOAT64) AS upper_bound,
  GREATEST(c.s_high, c.s_low) * IF(c.s_high >= c.s_low, 1, -1) AS score,
  c.alarm_high OR c.alarm_low AS is_anomaly,
  'cusum' AS method,
  CURRENT_TIMESTAMP() AS loaded_at
FROM run_cusum AS r
CROSS JOIN UNNEST(r.cusum_values) AS c WITH OFFSET AS pos
WHERE r.points[OFFSET(pos)].metric_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 90 DAY)
