-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 17/11/2026

config {
  type: "table",
  schema: constants.SCHEMAS.ecommerce,
  name: "ecom_abc_xyz_classification",
  description: "The supply chain classic, fed by GA4: ABC by revenue (A = the products that make 80% of it) crossed with XYZ by how predictable the weekly demand is (coefficient of variation of the units of the last 26 weeks), plus the Syntetos-Boylan demand pattern (smooth, erratic, intermittent, lumpy) and the stability of the INTEREST (views) next to the stability of the sales. Every cell with a suggested stock policy (cfg_insights.abc_xyz.policies). An AZ product (big and unpredictable) whose views are stable is a stock problem, not a demand problem",
  bigquery: {
    labels: { layer: "marts", domain: "ecommerce", level: "mid" }
  },
  tags: ["marts", "ecommerce", "daily", "insights", "merchandising"],
  columns: {
    abc_class: "A (cumulative revenue up to abc_cut[0]) | B (up to abc_cut[1]) | C",
    xyz_class: "X (cv of weekly units < xyz_cut[0]) | Y (< xyz_cut[1]) | Z",
    cv_weekly_units: "Standard deviation / mean of the weekly units, zero weeks included",
    average_demand_interval: "Weeks / weeks with sales (1 = sells every week)",
    cv2_nonzero_demand: "Squared CV of the units of the weeks with sales",
    demand_pattern: "smooth | erratic | intermittent | lumpy (Syntetos & Boylan 2005)",
    cv_weekly_views: "Same CV for the product views: interest stable while sales are not = stock or price problem",
    suggested_policy: "Policy of the abc_xyz cell (cfg_insights.abc_xyz.policies)"
  }
}

js {
  const ax = cfg_insights.abc_xyz;
  const policyCase = "CASE CONCAT(abc_class, xyz_class)\n" + Object.keys(ax.policies).map(k => `    WHEN '${k}' THEN ${helpers.sqlString(ax.policies[k])}`).join("\n") + "\n    ELSE NULL\n  END";
}

WITH
calendar AS (
  SELECT DATE_TRUNC(${helpers.today()}, WEEK(MONDAY)) AS this_week
),

weeks AS (
  SELECT week_start
  FROM calendar AS c
  CROSS JOIN UNNEST(GENERATE_DATE_ARRAY(DATE_SUB(c.this_week, INTERVAL ${ax.weeks * 7} DAY), DATE_SUB(c.this_week, INTERVAL 7 DAY), INTERVAL 1 WEEK)) AS week_start
),

sales AS (
  SELECT
    item_id,
    DATE_TRUNC(transaction_date, WEEK(MONDAY)) AS week_start,
    SUM(COALESCE(quantity, 1)) AS units,
    SUM(COALESCE(item_revenue, 0)) AS revenue
  FROM ${ref("fct_transaction_items")}
  CROSS JOIN calendar AS c
  WHERE is_valid_for_revenue
    AND item_id IS NOT NULL
    AND transaction_date >= DATE_SUB(c.this_week, INTERVAL ${ax.weeks * 7} DAY)
    AND transaction_date < c.this_week
  GROUP BY 1, 2
),

views AS (
  SELECT item_id, DATE_TRUNC(event_date, WEEK(MONDAY)) AS week_start, COUNT(*) AS views
  FROM ${ref("fct_item_interactions")}
  CROSS JOIN calendar AS c
  WHERE event_name = 'view_item'
    AND item_id IS NOT NULL
    AND event_date >= DATE_SUB(c.this_week, INTERVAL ${ax.weeks * 7} DAY)
    AND event_date < c.this_week
    ${helpers.martSessionFilter()}
  GROUP BY 1, 2
),

items AS (
  SELECT DISTINCT item_id FROM sales
),

weekly AS (
  SELECT
    i.item_id,
    w.week_start,
    COALESCE(s.units, 0) AS units,
    COALESCE(s.revenue, 0) AS revenue,
    COALESCE(v.views, 0) AS views
  FROM items AS i
  CROSS JOIN weeks AS w
  LEFT JOIN sales AS s ON s.item_id = i.item_id AND s.week_start = w.week_start
  LEFT JOIN views AS v ON v.item_id = i.item_id AND v.week_start = w.week_start
),

per_item AS (
  SELECT
    item_id,
    COUNT(*) AS weeks,
    SUM(revenue) AS revenue,
    SUM(units) AS units,
    SUM(views) AS views,
    COUNTIF(units > 0) AS weeks_with_sales,
    AVG(units) AS mean_weekly_units,
    SAFE_DIVIDE(STDDEV_POP(units), AVG(units)) AS cv_weekly_units,
    SAFE_DIVIDE(STDDEV_POP(views), AVG(views)) AS cv_weekly_views,
    SAFE_DIVIDE(STDDEV_POP(IF(units > 0, units, NULL)), AVG(IF(units > 0, units, NULL))) AS cv_nonzero_units
  FROM weekly
  GROUP BY 1
),

ranked AS (
  SELECT
    *,
    SAFE_DIVIDE(revenue, SUM(revenue) OVER ()) AS revenue_share,
    SAFE_DIVIDE(SUM(revenue) OVER (ORDER BY revenue DESC, item_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), SUM(revenue) OVER ()) AS cumulative_revenue_share
  FROM per_item
  WHERE revenue > 0
),

classified AS (
  SELECT
    *,
    -- the item that crosses 80% is still an A
    CASE
      WHEN cumulative_revenue_share - revenue_share < ${ax.abc_cut[0]} THEN 'A'
      WHEN cumulative_revenue_share - revenue_share < ${ax.abc_cut[1]} THEN 'B'
      ELSE 'C'
    END AS abc_class,
    CASE
      WHEN cv_weekly_units < ${ax.xyz_cut[0]} THEN 'X'
      WHEN cv_weekly_units < ${ax.xyz_cut[1]} THEN 'Y'
      ELSE 'Z'
    END AS xyz_class,
    SAFE_DIVIDE(weeks, weeks_with_sales) AS average_demand_interval,
    POW(COALESCE(cv_nonzero_units, 0), 2) AS cv2_nonzero_demand
  FROM ranked
)

SELECT
  c.item_id,
  i.item_name,
  i.item_brand,
  i.item_category,
  c.revenue,
  c.revenue_share,
  c.cumulative_revenue_share,
  c.units,
  c.views,
  c.weeks,
  c.weeks_with_sales,
  c.mean_weekly_units,
  c.cv_weekly_units,
  c.cv_weekly_views,
  c.average_demand_interval,
  c.cv2_nonzero_demand,
  c.abc_class,
  c.xyz_class,
  CONCAT(c.abc_class, c.xyz_class) AS abc_xyz,
  CASE
    WHEN c.average_demand_interval < ${ax.adi_cut} AND c.cv2_nonzero_demand < ${ax.cv2_cut} THEN 'smooth'
    WHEN c.average_demand_interval < ${ax.adi_cut} THEN 'erratic'
    WHEN c.cv2_nonzero_demand < ${ax.cv2_cut} THEN 'intermittent'
    ELSE 'lumpy'
  END AS demand_pattern,
  c.xyz_class = 'Z' AND c.cv_weekly_views < ${ax.xyz_cut[0]} AS stable_interest_unstable_sales,
  ${policyCase.replace(/abc_class/g, "c.abc_class").replace(/xyz_class/g, "c.xyz_class")} AS suggested_policy,
  CURRENT_TIMESTAMP() AS loaded_at
FROM classified AS c
LEFT JOIN ${ref("dim_items")} AS i USING (item_id)
