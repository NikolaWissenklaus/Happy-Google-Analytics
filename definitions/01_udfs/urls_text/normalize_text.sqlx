config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.udf,
  name: "normalize_text",
  description: "Lower case, no accents, only letters/numbers and single spaces. Good for search terms and names",
  dependencies: ["ops_bootstrap_datasets"],
  tags: ["udf", "daily"]
}

-- "  Tênis   AZUL-marinho!! " -> "tenis azul marinho"
CREATE OR REPLACE FUNCTION ${self()}(text STRING) RETURNS STRING AS (
  NULLIF(TRIM(REGEXP_REPLACE(
    LOWER(REGEXP_REPLACE(NORMALIZE(text, NFD), r'\p{M}', '')),
    r'[^a-z0-9]+', ' '
  )), '')
)
OPTIONS (description = "Text normalization")
