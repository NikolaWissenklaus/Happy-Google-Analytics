config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.udf,
  name: "benford_expected",
  description: "Benford law expected share of a first digit (1-9): LOG10(1 + 1/d). 1 should start ~30.1% of natural values",
  dependencies: ["ops_bootstrap_datasets"],
  tags: ["udf", "daily", "stats"]
}

CREATE OR REPLACE FUNCTION ${self()}(digit INT64) RETURNS FLOAT64 AS (
  IF(digit BETWEEN 1 AND 9, LOG10(1 + 1 / digit), NULL)
)
OPTIONS (description = "Benford law expected frequency")
