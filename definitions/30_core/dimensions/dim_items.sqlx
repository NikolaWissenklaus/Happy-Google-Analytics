-- author: Francisco Lucas / Nikola Wissenklaus / Chico

config {
  type: "table",
  schema: constants.SCHEMAS.core,
  name: "dim_items",
  description: "Product catalog as GA4 sees it: latest name / brand / categories, current price, first and last time seen, lifetime funnel numbers. Also says when the same item_id has many names (catalog mess)",
  bigquery: {
    clusterBy: ["item_id"],
    labels: { layer: "core", domain: "ecommerce" }
  },
  tags: ["ga4", "core", "daily", "ecommerce"],
  columns: {
    name_variants: "How many different item_name the same item_id had. > 1 = catalog / tracking inconsistency",
    current_price: "Median price on the last day the item was seen",
    days_since_last_seen: "No views in 30+ days may mean the product left the catalog (or broke)"
  }
}

WITH
item_events AS (
  SELECT *
  FROM ${ref("stg_ga4__event_items")}
  WHERE item_id IS NOT NULL
    AND NOT is_internal_traffic
),

latest_attributes AS (
  SELECT
    item_id,
    ARRAY_AGG(STRUCT(item_name, item_brand, item_variant, item_category, item_category2, item_category3, item_category4, item_category5)
      ORDER BY event_ts DESC LIMIT 1)[OFFSET(0)] AS latest,
    COUNT(DISTINCT item_name) AS name_variants,
    COUNT(DISTINCT item_category) AS category_variants,
    MIN(event_date) AS first_seen_date,
    MAX(event_date) AS last_seen_date,
    COUNTIF(event_name = 'view_item_list') AS lifetime_impressions,
    COUNTIF(event_name = 'select_item') AS lifetime_clicks,
    COUNTIF(event_name = 'view_item') AS lifetime_views,
    COUNTIF(event_name = 'add_to_cart') AS lifetime_add_to_carts,
    SUM(IF(event_name = 'purchase', COALESCE(quantity, 1), 0)) AS lifetime_units_sold,
    SUM(IF(event_name = 'purchase', item_revenue_fixed, 0)) AS lifetime_item_revenue
  FROM item_events
  GROUP BY item_id
),

current_price AS (
  SELECT item_id, median_price AS current_price, event_date AS price_date
  FROM ${ref("int_ga4__item_prices_daily")}
  QUALIFY ROW_NUMBER() OVER (PARTITION BY item_id ORDER BY event_date DESC) = 1
)

SELECT
  a.item_id,
  a.latest.item_name,
  a.latest.item_brand,
  a.latest.item_variant,
  a.latest.item_category,
  a.latest.item_category2,
  a.latest.item_category3,
  a.latest.item_category4,
  a.latest.item_category5,
  CONCAT(COALESCE(a.latest.item_category, '(not set)'), IF(a.latest.item_category2 IS NULL, '', CONCAT(' > ', a.latest.item_category2)), IF(a.latest.item_category3 IS NULL, '', CONCAT(' > ', a.latest.item_category3))) AS category_path,
  a.name_variants,
  a.category_variants,
  a.first_seen_date,
  a.last_seen_date,
  DATE_DIFF(CURRENT_DATE('${constants.TIMEZONE}'), a.last_seen_date, DAY) AS days_since_last_seen,
  p.current_price,
  p.price_date,
  a.lifetime_impressions,
  a.lifetime_clicks,
  a.lifetime_views,
  a.lifetime_add_to_carts,
  a.lifetime_units_sold,
  a.lifetime_item_revenue,
  SAFE_DIVIDE(a.lifetime_add_to_carts, a.lifetime_views) AS lifetime_cart_to_view_rate,
  CURRENT_TIMESTAMP() AS loaded_at
FROM latest_attributes AS a
LEFT JOIN current_price AS p USING (item_id)
