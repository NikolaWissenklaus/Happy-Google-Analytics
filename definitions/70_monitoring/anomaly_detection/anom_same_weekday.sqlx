-- v1: 16/01/2025

config {
  type: "table",
  schema: constants.SCHEMAS.anomaly,
  name: "anom_same_weekday",
  description: "Method 2 - z-score against the SAME WEEKDAY of the previous 8 weeks. Mondays compared with mondays. Kills most of the false alarms of the weekly seasonality",
  bigquery: {
    partitionBy: "metric_date",
    clusterBy: ["metric", "breakdown"],
    labels: { layer: "monitoring", domain: "anomaly" }
  },
  tags: ["monitoring", "anomaly", "daily"]
}

WITH stats AS (
  SELECT
    *,
    AVG(value) OVER w AS expected,
    STDDEV_SAMP(value) OVER w AS sd,
    COUNT(value) OVER w AS history_points
  FROM ${ref("anom_metric_series_daily")}
  WINDOW w AS (
    PARTITION BY metric, breakdown, breakdown_value, EXTRACT(DAYOFWEEK FROM metric_date)
    ORDER BY UNIX_DATE(metric_date)
    RANGE BETWEEN ${cfg_anomaly.same_weekday.weeks * 7} PRECEDING AND 1 PRECEDING
  )
)

SELECT
  metric_date,
  metric,
  breakdown,
  breakdown_value,
  value,
  expected,
  expected - ${cfg_anomaly.same_weekday.threshold} * sd AS lower_bound,
  expected + ${cfg_anomaly.same_weekday.threshold} * sd AS upper_bound,
  SAFE_DIVIDE(value - expected, sd) AS score,
  history_points >= 4 AND ABS(SAFE_DIVIDE(value - expected, sd)) > ${cfg_anomaly.same_weekday.threshold} AS is_anomaly,
  'same_weekday' AS method,
  CURRENT_TIMESTAMP() AS loaded_at
FROM stats
WHERE metric_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 90 DAY)
