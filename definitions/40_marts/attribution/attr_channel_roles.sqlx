-- v1: 22/04/2020

config {
  type: "table",
  schema: constants.SCHEMAS.attribution,
  name: "attr_channel_roles",
  description: "What each channel does in the journey (last 90 days, multi touch paths only): introducer (first), assistant (middle) or closer (last), plus the first x last channel matrix in the same table (role = matrix rows)",
  bigquery: {
    labels: { layer: "marts", domain: "attribution" }
  },
  tags: ["marts", "attribution", "daily"],
  columns: {
    main_role: "introducer / assistant / closer, whatever has the biggest share for the channel",
    first_channel: "Only for row_type = first_last_matrix",
    last_channel: "Only for row_type = first_last_matrix"
  }
}

WITH
multi_touch AS (
  SELECT *
  FROM ${ref("attr_credits_rule_based")}
  WHERE conversion_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 90 DAY)
    AND path_length > 1
),

roles AS (
  SELECT
    key_event_name,
    channel,
    COUNTIF(touch_index = 1) AS as_introducer,
    COUNTIF(touch_index > 1 AND touch_index < path_length) AS as_assistant,
    COUNTIF(touch_index = path_length) AS as_closer
  FROM multi_touch
  GROUP BY 1, 2
),

role_rows AS (
  SELECT
    'channel_role' AS row_type,
    key_event_name,
    channel,
    CAST(NULL AS STRING) AS first_channel,
    CAST(NULL AS STRING) AS last_channel,
    as_introducer,
    as_assistant,
    as_closer,
    SAFE_DIVIDE(as_introducer, as_introducer + as_assistant + as_closer) AS introducer_share,
    SAFE_DIVIDE(as_assistant, as_introducer + as_assistant + as_closer) AS assistant_share,
    SAFE_DIVIDE(as_closer, as_introducer + as_assistant + as_closer) AS closer_share,
    CASE GREATEST(as_introducer, as_assistant, as_closer)
      WHEN as_introducer THEN 'introducer'
      WHEN as_closer THEN 'closer'
      ELSE 'assistant'
    END AS main_role,
    CAST(NULL AS INT64) AS conversions
  FROM roles
),

first_last_counts AS (
  SELECT key_event_name, first_channel, last_channel, COUNT(*) AS conversions
  FROM ${ref("attr_conversion_paths")}
  WHERE conversion_date >= DATE_SUB(CURRENT_DATE('${constants.TIMEZONE}'), INTERVAL 90 DAY)
  GROUP BY key_event_name, first_channel, last_channel
),

matrix_rows AS (
  SELECT
    'first_last_matrix' AS row_type,
    key_event_name,
    CAST(NULL AS STRING) AS channel,
    first_channel,
    last_channel,
    CAST(NULL AS INT64), CAST(NULL AS INT64), CAST(NULL AS INT64),
    CAST(NULL AS FLOAT64), CAST(NULL AS FLOAT64), CAST(NULL AS FLOAT64),
    CAST(NULL AS STRING),
    conversions
  FROM first_last_counts
)

SELECT *, CURRENT_TIMESTAMP() AS loaded_at FROM role_rows
UNION ALL
SELECT *, CURRENT_TIMESTAMP() AS loaded_at FROM matrix_rows
