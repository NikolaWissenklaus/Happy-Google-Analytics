-- author: Francisco Lucas / Nikola Wissenklaus / Chico
-- v1: 18/11/2026

config {
  type: "table",
  schema: constants.SCHEMAS.product,
  name: "prod_streaming_titles",
  disabled: !cfg_extras.streaming.enabled,
  description: "Streaming, video on demand, podcasts, courses: per title (and series) in the last 90 days, plays, viewers, completion rate, the share of plays that happened in binge sessions (cfg_extras.streaming.binge_min_titles+ titles in the session), the share of viewers that came back to play anything in the next 7 days, and how many subscriptions had the title as the LAST thing watched before subscribing (the titles that sell the plan). 'The documentary has few viewers but it is the last title before 12% of the subscriptions: put it in the trailer of the home'",
  bigquery: {
    labels: { layer: "marts", domain: "product" }
  },
  tags: ["marts", "product", "daily", "vertical", "streaming"],
  columns: {
    completion_rate: "Completes / plays",
    binge_play_share: "Plays inside sessions with binge_min_titles or more distinct titles started",
    came_back_7d_rate: "Viewers of the title that played anything again in the 7 days after the first play of the title (only viewers older than 7 days)",
    subscriptions_after_title: "Subscriptions where this was the last title played by the user before subscribing (same day or the 7 days before)"
  }
}

js {
  const s = cfg_extras.streaming;
  const series = s.series_param ? ga4.paramStr(s.series_param) : "CAST(NULL AS STRING)";
}

WITH
media_events AS (
  SELECT
    event_date,
    event_ts,
    event_name,
    user_key,
    session_key,
    ${ga4.paramStr(s.title_param)} AS title,
    ${series} AS series
  FROM ${ref("fct_events")}
  WHERE event_date >= ${helpers.daysAgo(90)}
    AND event_name IN (${helpers.sqlList([s.play_event, s.progress_event, s.complete_event])})
    ${helpers.noiseFilter()}
),

plays AS (
  SELECT * FROM media_events WHERE event_name = ${helpers.sqlString(s.play_event)} AND title IS NOT NULL
),

session_titles AS (
  SELECT session_key, COUNT(DISTINCT title) AS titles_in_session
  FROM plays
  GROUP BY 1
),

first_play_per_title AS (
  SELECT user_key, title, MIN(event_ts) AS first_play_ts
  FROM plays
  GROUP BY 1, 2
),

came_back AS (
  SELECT
    f.title,
    COUNTIF(f.first_play_ts <= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 7 DAY)) AS mature_viewers,
    COUNTIF(f.first_play_ts <= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 7 DAY) AND n.next_play_ts IS NOT NULL) AS came_back_viewers
  FROM first_play_per_title AS f
  LEFT JOIN (
    SELECT f2.user_key, f2.title, MIN(p.event_ts) AS next_play_ts
    FROM first_play_per_title AS f2
    JOIN plays AS p
      ON p.user_key = f2.user_key
      AND p.event_ts > TIMESTAMP_ADD(f2.first_play_ts, INTERVAL 1 HOUR)
      AND p.event_ts <= TIMESTAMP_ADD(f2.first_play_ts, INTERVAL 7 DAY)
    GROUP BY 1, 2
  ) AS n USING (user_key, title)
  GROUP BY 1
),

subscriptions AS (
  SELECT user_key, MIN(event_ts) AS subscribe_ts
  FROM ${ref("fct_events")}
  WHERE event_date >= ${helpers.daysAgo(90)}
    AND ${helpers.inList("event_name", s.subscribe_events)}
    ${helpers.noiseFilter()}
  GROUP BY 1
),

last_title_before_subscribe AS (
  SELECT
    ARRAY_AGG(p.title ORDER BY p.event_ts DESC LIMIT 1)[OFFSET(0)] AS title
  FROM subscriptions AS sub
  JOIN plays AS p
    ON p.user_key = sub.user_key
    AND p.event_ts <= sub.subscribe_ts
    AND p.event_ts >= TIMESTAMP_SUB(sub.subscribe_ts, INTERVAL 7 DAY)
  GROUP BY sub.user_key
),

per_title AS (
  SELECT
    m.title,
    ANY_VALUE(m.series) AS series,
    COUNTIF(m.event_name = ${helpers.sqlString(s.play_event)}) AS plays,
    COUNT(DISTINCT IF(m.event_name = ${helpers.sqlString(s.play_event)}, m.user_key, NULL)) AS viewers,
    COUNTIF(m.event_name = ${helpers.sqlString(s.complete_event)}) AS completes,
    COUNTIF(m.event_name = ${helpers.sqlString(s.play_event)} AND st.titles_in_session >= ${s.binge_min_titles}) AS binge_plays
  FROM media_events AS m
  LEFT JOIN session_titles AS st USING (session_key)
  WHERE m.title IS NOT NULL
  GROUP BY 1
)

SELECT
  t.title,
  t.series,
  t.plays,
  t.viewers,
  t.completes,
  SAFE_DIVIDE(t.completes, t.plays) AS completion_rate,
  SAFE_DIVIDE(t.binge_plays, t.plays) AS binge_play_share,
  SAFE_DIVIDE(c.came_back_viewers, c.mature_viewers) AS came_back_7d_rate,
  COALESCE(s.subscriptions_after_title, 0) AS subscriptions_after_title,
  SAFE_DIVIDE(COALESCE(s.subscriptions_after_title, 0), t.viewers) AS subscriptions_per_viewer,
  RANK() OVER (ORDER BY COALESCE(s.subscriptions_after_title, 0) DESC) AS rank_by_subscriptions,
  RANK() OVER (ORDER BY t.viewers DESC) AS rank_by_viewers,
  CURRENT_TIMESTAMP() AS loaded_at
FROM per_title AS t
LEFT JOIN came_back AS c USING (title)
LEFT JOIN (SELECT title, COUNT(*) AS subscriptions_after_title FROM last_title_before_subscribe GROUP BY 1) AS s USING (title)
